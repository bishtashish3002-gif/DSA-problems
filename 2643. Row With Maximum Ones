class Solution {
    public int[] rowAndMaximumOnes(int[][] mat) {
        int [] result = new int[2];
        int max=Integer.MIN_VALUE;
        for(int i =0; i<mat.length; i++){
            int count =0;
            for(int j = 0; j<mat[i].length; j++){
                if(1 == mat[i][j]){
                    count++;
                }
            }
            if(count>max){
                max=count;
                result[0] = i;
                result[1] = max;
            }
        }
        return result;
    }
}
