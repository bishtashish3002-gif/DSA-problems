class Solution {
    public int longestOnes(int[] nums, int k) {
        int s=0;
        int zero=0;
        int c=0;
        for(int e=0;e<nums.length;e++){
            if(nums[e]==0){
                zero++;
              
            }
            while(zero>k){
                if(nums[s]==0){
            
                   zero--;
                }s++;
            }
           c=Math.max(c,e-s+1);
        }
        return c;
    }
}
