class Solution {
    public int numOfSubarrays(int[] arr) {
        long result=0;
        int sum=0;
        int even= 1;
        int odd=0;
        int mob = 1000000007;
        for(int num : arr){
            sum+=num;

            if(sum%2==0){
                result += odd;
                even++;
            }else{
                result += even;
                odd++;
            }
        }
        return (int) (result % mob);
    }
}
