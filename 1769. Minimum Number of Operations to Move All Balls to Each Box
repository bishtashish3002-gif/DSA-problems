class Solution {
    public int[] minOperations(String boxes) {
        int n = boxes.length();
        int[] res = new int[n];
        for(int i = 0; i<n; i++){
            int count =0;
            for(int j =0; j<n; j++){
                if(i ==j) continue;
                if(boxes.charAt(j) == '1'){
                    count = count + Math.abs(i-j);
                }
            }
            res[i] = count;
        }
        return res;
        
    }
}
