class Solution {
    public int romanToInt(String s) {
        Map<Character, Integer> t = new HashMap<>();
            t.put('I',1);
            t.put('V',5);
            t.put('X',10);
            t.put('L',50);
            t.put('C',100);
            t.put('D',500);
            t.put('M',1000);
        int res=0;
        for (int i=0; i<s.length();i++){
            int curr = t.get(s.charAt(i));
            if (i + 1 < s.length() && curr < t.get(s.charAt(i + 1))) {
                res -= curr;
            }
            else
            res+=curr;
        }
        return res;
    }
}

