class Solution(object):
    def canJump(self, nums):
        farthest = 0
        for i, jumping_Power in enumerate(nums):
            if i>farthest:
                return False
            farthest = max(farthest, i + jumping_Power)    
            if (farthest>= len(nums)-1):
                return True
        return False
        
